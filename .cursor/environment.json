{
  "name": "Market Intelligence Platform",
  "install": "bash scripts/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "bash scripts/run-backend.sh",
      "description": "FastAPI market-data API on http://localhost:8000"
    },
    {
      "name": "frontend",
      "command": "bash scripts/run-frontend.sh",
      "description": "Vite dev server / dashboard on http://localhost:5173 (proxies /api to the backend)"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
